# frozen_string_literal: true

default_platform(:ios)

platform :ios do
  desc "Build, archive, and upload repofeed to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]

    key_id = ENV.fetch("APP_STORE_CONNECT_KEY_ID")
    issuer_id = ENV.fetch("APP_STORE_CONNECT_ISSUER_ID")
    key_path = ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH")
    team_id = ENV.fetch("APPLE_TEAM_ID")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      duration: 1200,
      in_house: false
    )

    # Prefer TestFlight+1 so retries stay unique; fall back to run number + offset.
    run_number = ENV.fetch("IOS_BUILD_NUMBER", "1").to_i
    begin
      latest = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: "ai.repofeed.app",
        initial_build_number: 0
      )
      build_number = [latest.to_i + 1, run_number].max.to_s
    rescue StandardError => e
      UI.important("Could not read latest TestFlight build (#{e.message}); using run number + offset")
      build_number = (run_number + 1000).to_s
    end
    UI.message("Using iOS build number #{build_number}")

    increment_build_number(
      build_number: build_number,
      xcodeproj: "ios/App/App.xcodeproj"
    )

    # Automatic signing for export. Do not set CODE_SIGN_IDENTITY here —
    # Apple Development needs registered devices; Apple Distribution conflicts
    # with "signed for development" automatic mode on a clean runner.
    update_code_signing_settings(
      use_automatic_signing: true,
      path: "ios/App/App.xcodeproj",
      team_id: team_id,
      bundle_identifier: "ai.repofeed.app"
    )

    FileUtils.mkdir_p("build")
    archive_path = File.expand_path("build/repofeed.xcarchive")

    # Archive UNSIGNED. A clean CI runner / team with no devices cannot create
    # an iOS App Development profile (which automatic signing would request at
    # archive time). Distribution signing happens only at export below.
    UI.message("Archiving unsigned → #{archive_path}")
    sh(
      "set -o pipefail && xcodebuild archive " \
      "-project ios/App/App.xcodeproj " \
      "-scheme App " \
      "-configuration Release " \
      "-destination 'generic/platform=iOS' " \
      "-archivePath '#{archive_path}' " \
      "CODE_SIGNING_ALLOWED=NO " \
      "CODE_SIGN_IDENTITY='' " \
      "DEVELOPMENT_TEAM=#{team_id} " \
      "CURRENT_PROJECT_VERSION=#{build_number} " \
      "| xcbeautify"
    )

    # Auth args must apply to -exportArchive only (not the unsigned archive).
    # Gym's xcargs are forwarded to export when skip_build_archive is set.
    auth_xcargs = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", key_path,
      "-authenticationKeyID", key_id,
      "-authenticationKeyIssuerID", issuer_id
    ].join(" ")

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      skip_build_archive: true,
      archive_path: archive_path,
      output_directory: "build",
      output_name: "repofeed.ipa",
      xcargs: auth_xcargs,
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: team_id
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
