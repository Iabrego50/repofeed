# frozen_string_literal: true

require "base64"
require "fileutils"
require "tmpdir"

default_platform(:ios)

PROFILE_NAME = "repofeed AppStore"
PROFILE_UUID = "a353e9cb-a93b-4c73-a7c4-c9de7d9b20b5"
BUNDLE_ID = "ai.repofeed.app"

platform :ios do
  desc "Build, archive, and upload repofeed to TestFlight (manual signing)"
  lane :beta do
    setup_ci if ENV["CI"]

    key_id = ENV.fetch("APP_STORE_CONNECT_KEY_ID")
    issuer_id = ENV.fetch("APP_STORE_CONNECT_ISSUER_ID")
    key_path = ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH")
    team_id = ENV.fetch("APPLE_TEAM_ID")
    cert_b64 = ENV.fetch("IOS_DIST_CERT_P12_BASE64")
    cert_password = ENV.fetch("IOS_DIST_CERT_PASSWORD")
    profile_b64 = ENV.fetch("IOS_APPSTORE_PROFILE_BASE64")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      duration: 1200,
      in_house: false
    )

    # Prefer TestFlight+1 so retries stay unique; fall back to run number + offset.
    run_number = ENV.fetch("IOS_BUILD_NUMBER", "1").to_i
    begin
      latest = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: BUNDLE_ID,
        initial_build_number: 0
      )
      build_number = [latest.to_i + 1, run_number].max.to_s
    rescue StandardError => e
      UI.important("Could not read latest TestFlight build (#{e.message}); using run number + offset")
      build_number = (run_number + 1000).to_s
    end
    UI.message("Using iOS build number #{build_number}")

    increment_build_number(
      build_number: build_number,
      xcodeproj: "ios/App/App.xcodeproj"
    )

    # Decode + import Apple Distribution .p12 into the CI keychain (from setup_ci).
    cert_path = File.join(Dir.tmpdir, "repofeed-dist.p12")
    File.binwrite(cert_path, Base64.decode64(cert_b64))
    import_certificate(
      certificate_path: cert_path,
      certificate_password: cert_password,
      keychain_name: ENV["MATCH_KEYCHAIN_NAME"] || "fastlane_tmp_keychain",
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"] || ""
    )

    # Install the App Store provisioning profile by UUID (Xcode looks here).
    profiles_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
    FileUtils.mkdir_p(profiles_dir)
    profile_path = File.join(profiles_dir, "#{PROFILE_UUID}.mobileprovision")
    File.binwrite(profile_path, Base64.decode64(profile_b64))
    UI.message("Installed provisioning profile → #{profile_path}")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      team_id: team_id,
      bundle_identifier: BUNDLE_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: PROFILE_NAME,
      build_configurations: ["Release"]
    )

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      output_name: "repofeed.ipa",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          BUNDLE_ID => PROFILE_NAME
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
