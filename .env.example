VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public origin for the deployed app. Server-side generation chaining uses
# SITE_URL, then VITE_SITE_URL, then https://${VERCEL_URL} (set by Vercel).
SITE_URL=
VITE_SITE_URL=
# Server-only secret for /api/generation/process self-calls.
# Send as header x-generation-internal-secret (also accepted as GENERATION_INTERNAL_SECRET).
GENERATION_INTERNAL_SECRET=
# Optional. Bypass Vercel Deployment Protection on preview self-calls.
# Project Settings → Deployment Protection → Protection Bypass for Automation.
# Sent as x-vercel-protection-bypass when chaining HTTP process steps.
VERCEL_AUTOMATION_BYPASS_SECRET=
OPENAI_API_KEY=
# Defaults: gpt-5.1 (text) and gpt-image-1 (images)
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
RESEND_API_KEY=
