{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/generation/process.ts": {
      "maxDuration": 300
    },
    "api/generation/start.ts": {
      "maxDuration": 60
    },
    "api/generation/recover.ts": {
      "maxDuration": 60
    },
    "api/art/paint.ts": {
      "maxDuration": 180
    },
    "api/videos/process.ts": {
      "maxDuration": 120
    },
    "api/videos/backfill.ts": {
      "maxDuration": 60
    },
    "api/insights/ask.ts": {
      "maxDuration": 60
    },
    "api/insights/topics.ts": {
      "maxDuration": 90
    }
  },
  "crons": [
    {
      "path": "/api/generation/recover",
      "schedule": "0 12 * * *"
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/signin", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/auth", "destination": "/index.html" },
    { "source": "/auth/callback", "destination": "/index.html" },
    { "source": "/auth/confirm", "destination": "/index.html" },
    { "source": "/demo", "destination": "/index.html" },
    { "source": "/for/:slug", "destination": "/index.html" },
    { "source": "/demo/insights", "destination": "/index.html" },
    { "source": "/demo/explore", "destination": "/index.html" },
    { "source": "/demo/deck", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/help", "destination": "/index.html" },
    { "source": "/welcome", "destination": "/index.html" },
    { "source": "/feed", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/studies", "destination": "/index.html" },
    { "source": "/studies/new", "destination": "/index.html" },
    { "source": "/studies/:studyId", "destination": "/index.html" },
    { "source": "/explore", "destination": "/index.html" },
    { "source": "/insights", "destination": "/index.html" },
    { "source": "/insights/deck", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/billing", "destination": "/index.html" },
    { "source": "/invite/:token", "destination": "/index.html" },
    { "source": "/s/:token", "destination": "/index.html" },
    { "source": "/share/:token", "destination": "/index.html" },
    { "source": "/admin/analytics", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://va.vercel-scripts.com https://js.stripe.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co https://*.stripe.com; font-src 'self' data:; connect-src 'self' https://odvpqotwaokflegpmmej.supabase.co wss://odvpqotwaokflegpmmej.supabase.co https://*.supabase.co wss://*.supabase.co https://api.stripe.com https://checkout.stripe.com https://vitals.vercel-insights.com https://va.vercel-scripts.com; frame-src https://js.stripe.com https://hooks.stripe.com https://checkout.stripe.com; media-src 'self' blob: https://*.supabase.co; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com https://*.stripe.com; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
        }
      ]
    }
  ]
}
